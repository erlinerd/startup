# Local env for the Hono Node server (apps/server). Copy to `.env`.
# Loaded by `tsx watch` / `node` via `--env-file-if-exists`. Never commit `.env`.
# In production, set the same keys via your host's environment.

# Server port (default 15200)
# PORT=15200

# Comma-separated CORS allowlist (defaults to localhost + Electron `null`)
# CORS_ORIGINS=https://your-app.com

# LibSQL / Turso database. Unset → GET /users returns 503.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# OpenAI. Unset → POST /api/chat returns 503.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
