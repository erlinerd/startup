{
  "name": "server",
  "version": "0.0.1",
  "description": "Hono API server on Node.js (@hono/node-server) with Vercel AI SDK streaming and Drizzle/LibSQL data layer.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "lint": "oxlint",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.33",
    "@hono/node-server": "^2.1.0",
    "@libsql/client": "^0.17.4",
    "@repo/db": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "^7.0.55",
    "hono": "^4.13.0",
    "tsx": "^4.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
