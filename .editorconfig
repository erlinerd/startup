# EditorConfig — keeps non-VSCode editors consistent with Prettier + project style.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.md]
# Markdown: preserve trailing whitespace (two trailing spaces = hard line break).
trim_trailing_whitespace = false

[*.{yml,yaml}]
# YAML commonly uses 2 spaces; keep consistent with the rest of the repo.
indent_size = 2

[Makefile]
# Makefiles require literal tabs.
indent_style = tab
