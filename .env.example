# Documented env for the whole stack. Each tool reads its own directory:
#   Next.js      -> apps/landing/.env.local
#   Vite         -> apps/desktop/.env.local
#   Node         -> apps/server/.env  (see apps/server/.env.example)
# All values are optional — the stack builds and tests with zero secrets.

# --- apps/server (Hono on Node.js via @hono/node-server) ---
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-turso-token
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
CORS_ORIGINS=https://your-app.com

# --- apps/landing (Next.js) ---
NEXT_PUBLIC_APP_NAME=Startup

# --- apps/desktop (Vite, set via VITE_ env at build time) ---
VITE_SERVER_URL=http://localhost:15200/
